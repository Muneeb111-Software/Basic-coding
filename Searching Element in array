#include<iostream>
using namespace std;
int main(){
	int arr[] ={12,121,56,99,1,45,64,78,7,2};
	int target =1;
	int n =sizeof(arr)/sizeof(arr[0]);
	bool found =true;
	for(int i=0;i<n;i++){
		if(arr[i] == target){
			found =true;
			break;
		}
	}
	if (found){
		cout<<"Element is  found  "<<endl;
	}
	else{
		cout<<"Elemenet not Found"<<endl;
	}

	return 0;
}
